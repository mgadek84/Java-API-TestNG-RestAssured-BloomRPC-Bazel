load("@rules_java//java:defs.bzl", "java_binary", "java_library")
load("//tools/testng:testng.bzl", "testng_test")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "chess_service",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = [
        "//proto/chess/v1:chess_java_grpc",
        "//proto/chess/v1:chess_java_proto",
        "@io_grpc_grpc_java//api",
        "@io_grpc_grpc_java//netty",
        "@io_grpc_grpc_java//stub",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
    ],
)

# bazel run //chess-service:server  ->  gRPC on localhost:50051 (for BloomRPC)
java_binary(
    name = "server",
    main_class = "io.github.mgadek84.chess.server.ChessServer",
    runtime_deps = [
        ":chess_service",
        "@maven//:org_slf4j_slf4j_simple",
    ],
)

# Hermetic: no Lichess calls (the Lichess client is faked), safe to run in parallel.
testng_test(
    name = "chess_service_test",
    size = "small",
    srcs = glob(["src/test/java/**/*.java"]),
    resources = glob(["src/test/resources/**"]),
    resource_strip_prefix = "chess-service/src/test/resources",
    suites = ["suites/chess-service.xml"],
    deps = [
        ":chess_service",
        "//proto/chess/v1:chess_java_grpc",
        "//proto/chess/v1:chess_java_proto",
        "@io_grpc_grpc_java//api",
        "@io_grpc_grpc_java//inprocess",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_testng_testng",
    ],
)
