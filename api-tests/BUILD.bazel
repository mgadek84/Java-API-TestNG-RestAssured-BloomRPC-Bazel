load("//tools/testng:testng.bzl", "testng_test")

package(default_visibility = ["//visibility:public"])

# Live calls the Virgin Australia booking UI makes while searching a fare.
# external: the site can change under us, so do not cache a green result.
testng_test(
    name = "virgin_booking_test",
    srcs = glob(["src/test/java/io/github/mgadek84/virgin/*.java"]),
    resources = glob(["src/test/resources/**"]),
    resource_strip_prefix = "api-tests/src/test/resources",
    suites = ["suites/virgin-booking.xml"],
    tags = [
        "external",
        "requires-network",
    ],
    deps = [
        "@maven//:io_rest_assured_json_path",
        "@maven//:io_rest_assured_rest_assured",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_testng_testng",
    ],
    runtime_deps = ["@maven//:org_slf4j_slf4j_simple"],
)
