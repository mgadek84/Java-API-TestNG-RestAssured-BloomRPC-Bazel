module(
    name = "virgin_booking_qa",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    # rules_java pulls protobuf, which also installs into this maven repo.
    known_contributing_modules = ["protobuf"],
    artifacts = [
        "io.rest-assured:json-path:6.3.0",
        "io.rest-assured:rest-assured:6.3.0",
        "org.hamcrest:hamcrest:3.0",
        "org.slf4j:slf4j-simple:2.0.17",
        "org.testng:testng:7.12.0",
    ],
    repositories = [
        "https://repo.maven.apache.org/maven2/",
    ],
)
use_repo(maven, "maven")
