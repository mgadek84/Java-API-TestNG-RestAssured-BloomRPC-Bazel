load("@com_google_protobuf//bazel/toolchains:proto_lang_toolchain.bzl", "proto_lang_toolchain")
load("@rules_java//java:defs.bzl", "java_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

# Prebuilt gRPC Java code generator for the machine running the build.
alias(
    name = "protoc_gen_grpc_java",
    actual = select({
        ":linux_x86_64": "@protoc_gen_grpc_java_linux_x86_64//file",
        ":linux_aarch64": "@protoc_gen_grpc_java_linux_aarch64//file",
        # grpc-java publishes an x86_64 binary for macOS; Apple Silicon runs it via Rosetta 2.
        ":macos": "@protoc_gen_grpc_java_osx_x86_64//file",
        ":windows": "@protoc_gen_grpc_java_windows_x86_64//file",
    }),
)

# Runtime libraries the generated ChessServiceGrpc.java compiles against.
java_library(
    name = "grpc_java_runtime",
    exports = [
        "@com_google_protobuf//:protobuf_java",
        "@io_grpc_grpc_java//api",
        "@io_grpc_grpc_java//protobuf",
        "@io_grpc_grpc_java//stub",
        # ChessServiceFutureStub returns Guava's ListenableFuture.
        "@maven//:com_google_guava_guava",
    ],
)

proto_lang_toolchain(
    name = "grpc_java_lang_toolchain",
    command_line = "--grpc-java_out=$(OUT)",
    output_files = "single",
    plugin = ":protoc_gen_grpc_java",
    plugin_format_flag = "--plugin=protoc-gen-grpc-java=%s",
    runtime = ":grpc_java_runtime",
)
